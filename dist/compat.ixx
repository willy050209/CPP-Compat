    /// <returns>自身參考</returns>
    COMPAT_CONSTEXPR_20 bigint& operator|=(const bigint& rhs) {
        detail::BigIntStorage tmp;
        detail::BigIntCore::bitwise_or(tmp, m_storage, rhs.m_storage);
        m_storage = std::move(tmp);
        return *this;
