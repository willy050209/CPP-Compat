    /// <returns>Result of f or expected holding moved error.</returns>
    template <typename F>
    auto and_then(F&& f) && -> decltype(std::forward<F>(f)()) {
        using Ret = typename std::remove_cv<typename std::remove_reference<decltype(std::forward<F>(f)())>::type>::type;
        if (has_value()) {
