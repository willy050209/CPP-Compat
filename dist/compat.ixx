    /// <summary>
    /// Obtains const rvalue reference to error or throws bad_expected_access.
    /// </summary>
    /// <returns>Const rvalue reference to error.</returns>
    /// <exception cref="bad_expected_access&lt;E&gt;">Thrown when in success state.</exception>
    const E&& error() const && {
