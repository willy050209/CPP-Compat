    COMPAT_CONSTEXPR_20 bigint& operator%=(const bigint& rhs) {
        detail::BigIntStorage q, r;
        detail::BigIntCore::div_mod_signed(q, r, m_storage, rhs.m_storage);
        m_storage = std::move(r);
        return *this;
    }

