    /// Obtains rvalue reference to error or throws bad_expected_access.
    /// </summary>
    /// <returns>Rvalue reference to error.</returns>
    /// <exception cref="bad_expected_access&lt;E&gt;">Thrown when in success state.</exception>
    E&& error() && {
